# Local environment variables for development.
#
# Copy this file to `.env` (`cp .env.example .env`) before running the app
# locally. The file can be left empty — it only needs to exist, because the
# dev script runs `node --watch --env-file-if-exists=.env` and `--watch`
# fails with ENOENT if the .env file is missing.

# --- Authentication --------------------------------------------------------
# Both providers default to `mock` (local demo identities, no credentials), so
# none of the values below are needed to run or demo the service. Set them only
# to exercise a real sign-in. See docs/auth/AUTH-ARCHITECTURE.md.

# External applicants — Defra Customer Identity (Azure AD B2C), OIDC.
# DEFRA_ID_AUTH_MODE=live
# DEFRA_ID_WELL_KNOWN_URL=     # OIDC discovery (well-known) document URL
# DEFRA_ID_CLIENT_ID=          # registered client id (also sent as a scope)
# DEFRA_ID_CLIENT_SECRET=      # confidential-client secret (never commit)
# DEFRA_ID_SERVICE_ID=         # Defra Identity service id (authorize param)
# DEFRA_ID_POLICY=             # B2C policy name (authorize param `p`)
# DEFRA_ID_PUBLIC_BASE_URL=    # public base URL for building redirect URIs
# DEFRA_ID_REDIRECT_PATH=/auth/defra-id/callback
# DEFRA_ID_SIGN_OUT_REDIRECT_URL=/
# Claim contract — override only if the live token uses different claim names.
# DEFRA_ID_CLAIM_SUB=sub
# DEFRA_ID_CLAIM_EMAIL=email
# DEFRA_ID_CLAIM_FIRST_NAME=firstName
# DEFRA_ID_CLAIM_LAST_NAME=lastName
# DEFRA_ID_CLAIM_CONTACT_ID=contactId
# DEFRA_ID_CLAIM_CURRENT_RELATIONSHIP_ID=currentRelationshipId
# DEFRA_ID_CLAIM_RELATIONSHIPS=relationships
# DEFRA_ID_CLAIM_ROLES=roles
# DEFRA_ID_CLAIM_SID=sessionId

# Internal case officers — Microsoft Entra ID (OIDC auth-code + PKCE).
# Live requires: ENTRA_AUTH_MODE=live + ENTRA_TENANT_ID + ENTRA_CLIENT_ID +
# ENTRA_CLIENT_SECRET. OIDC endpoints are derived from the tenant authority
# (no well-known URL to set). Deployed: non-secret values via cdp-app-config,
# the secret via the CDP Secrets page.
# ENTRA_AUTH_MODE=live
# ENTRA_TENANT_ID=             # tenant (directory) id
# ENTRA_CLIENT_ID=            # application (client) id
# ENTRA_CLIENT_SECRET=        # secret — CDP Secrets page only, NEVER commit
# ENTRA_PUBLIC_BASE_URL=      # public base URL; with ENTRA_REDIRECT_PATH it forms
#                             # the redirect URI that must be registered on the app reg
# ENTRA_REDIRECT_PATH=/auth/entra/callback
# ENTRA_SIGN_OUT_REDIRECT_URL=/
# ENTRA_CASE_OFFICER_ROLE_VALUE=case_officer   # must match the Entra app-role value
