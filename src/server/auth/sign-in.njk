{% extends 'layouts/page.njk' %}

{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "Pesticides"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if authError == 'auth-required' %}
        {{ govukNotificationBanner({
          text: "You need to sign in to continue.",
          type: "important"
        }) }}
      {% endif %}

      <p class="govuk-body">Choose how you want to sign in:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>
          <a class="govuk-link" href="/auth/defra-id/sign-in" data-testid="choose-applicant">Applicants</a>
          — sign in with Defra Customer Identity to register and manage applications.
        </li>
        <li>
          <a class="govuk-link" href="/auth/entra/sign-in" data-testid="choose-case-officer">Case officers</a>
          — HSE/CRD staff sign in with their Defra staff account.
        </li>
      </ul>

    </div>
  </div>

{% endblock %}
