{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "pesticides-poc-frontend"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-body" data-testid="app-page-body">
        {% if session.isAuthenticated %}
          <p>You are signed in as <strong>{{ session.name }}</strong> ({{ session.roleLabel or session.role }}).</p>
          <p>
            <a class="govuk-link" href="/auth/account">View your account</a>
            or <a class="govuk-link" href="/auth/sign-out">sign out</a>.
          </p>
        {% else %}
          <p>Sign in to the pesticides service:</p>
          <ul class="govuk-list govuk-list--bullet">
            <li><a class="govuk-link" href="/auth/defra-id/sign-in" data-testid="home-applicant-sign-in">Applicants (Defra Customer Identity)</a></li>
            <li><a class="govuk-link" href="/auth/entra/sign-in" data-testid="home-staff-sign-in">Case officers (Microsoft Entra ID)</a></li>
          </ul>
        {% endif %}
      </div>
    </div>
  </div>

{% endblock %}
