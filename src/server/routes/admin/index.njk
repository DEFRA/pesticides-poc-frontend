{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "Case officer"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body" data-testid="admin-officer">
        Signed in as {{ session.name }} ({{ session.roleLabel or session.role }}).
      </p>
      <p class="govuk-body">
        The applications list will appear here. This view is a placeholder for the
        case-officer sign-in POC.
      </p>
      <p class="govuk-body">
        <a class="govuk-link" href="/auth/sign-out">Sign out</a>
      </p>
    </div>
  </div>

{% endblock %}
